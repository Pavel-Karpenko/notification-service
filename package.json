{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Notification Preferences Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node -e \"require('./dist/infrastructure/db/migrate.js')\"",
    "test": "vitest run tests/unit && vitest run tests/integration --poolOptions.threads.singleThread",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --poolOptions.threads.singleThread",
    "test:e2e": "vitest run tests/e2e",
    "load": "node scripts/load.js",
    "lint": "tsc --noEmit && eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "ioredis": "^5.3.2",
    "luxon": "^3.4.4",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.1.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.21.4",
    "eslint": "^10.4.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.60.0",
    "vitest": "^1.6.0"
  }
}
